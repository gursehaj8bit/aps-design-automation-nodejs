# APS (Autodesk Platform Services) credentials, read by config.js.
# Get these from the app's page on https://aps.autodesk.com/myapps

# The page's four environments, each its own APS app. The page switches between them; one left
# unset shows greyed out, and the server needs at least one. A change to prod (publish, create,
# delete, Clear account) asks for "prod" to be typed first, and the server refuses it otherwise.
# While both APS_DEV_* are unset, dev uses the APS_CLIENT_ID / APS_CLIENT_SECRET app below.
APS_DEV_CLIENT_ID=
APS_DEV_CLIENT_SECRET=
APS_TESTING_CLIENT_ID=
APS_TESTING_CLIENT_SECRET=
APS_UAT_CLIENT_ID=
APS_UAT_CLIENT_SECRET=
APS_PROD_CLIENT_ID=
APS_PROD_CLIENT_SECRET=

# The app the command-line scripts work on (npm run publish:*, check:remote, family:svf).
# The page uses it only as dev's stand-in.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Public URL Design Automation calls back to when a work item finishes
# (e.g. an ngrok tunnel pointing at this server: https://<id>.ngrok-free.app)
APS_WEBHOOK_URL=

# OAuth callback; only needed for 3-legged auth. APS_CALLBACK is also accepted.
APS_CALLBACK_URL=

# Port the Express server listens on (default 8080)
PORT=

# Azure Blob Storage, read by routes/BlobStorage.js (the /blob.html page).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
# Container or account SAS token (with or without the leading '?'). Needs r,w,d,l to list,
# upload, download and delete.
AZURE_STORAGE_SAS_TOKEN=
# Optional. When set, "Generate SAS URL" mints a read-only link with its own expiry instead of
# reusing the token above.
AZURE_STORAGE_ACCOUNT_KEY=

# Publishing add-ins from the parent repo (npm run publish:bundle / publish:activity / check:remote).
# Folder holding <Id>/addin.json, <Id>/activities/<task>.json and <Id>/dist/<Id>.zip.
# Default: ../addins (the parent repo's revit/addins). A relative path is taken from this folder.
ADDINS_ROOT=
# The Design Automation owner filled into {{owner}}. Default: ask Design Automation for this app's
# nickname (GET /forgeapps/me), which is the client id when no nickname was ever set.
APS_DA_NICKNAME=
